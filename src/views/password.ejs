<%- include('partials/head') %>
<%- include('partials/pagehero', {eyebrow: 'Members', heading: 'Change password', lead: 'Signed in as ' + (me.username || me.name) + '.', doodle: 's-flag'}) %>
<div class="page-body"><div class="wrap lift" style="max-width:560px">
  <form class="card form pad-lg" method="post" action="/account/password" novalidate><%- include('partials/csrf') %><input type="hidden" name="via" value="page">
    <%- include('partials/field', {name:'current_password', label:'Current password', type:'password', values: {}, errors: errors, autocomplete:'current-password', attrs:'required'}) %>
    <%- include('partials/field', {name:'new_password', label:'New password', type:'password', values: {}, errors: errors, autocomplete:'new-password', hint:'At least 10 characters.', attrs:'required minlength="10" maxlength="200"'}) %>
    <%- include('partials/field', {name:'new_password2', label:'Repeat new password', type:'password', values: {}, errors: errors, autocomplete:'new-password', attrs:'required minlength="10" maxlength="200"'}) %>
    <button class="btn btn-pk btn-full" type="submit">Change password</button>
    <p class="fine" style="margin:0">Forgotten it? Ask an admin to reset it for you.</p>
  </form>
  <form method="post" action="/logout" style="margin-top:14px"><%- include('partials/csrf') %><button class="btn btn-dn" type="submit">Log out</button></form>
</div></div>
<%- include('partials/foot') %>
