<%- include('partials/head') %>
<%- include('partials/pagehero', {eyebrow: 'Knockout', heading: b ? b.comp.name : 'Matchplay', lead: b && b.comp.notes ? b.comp.notes : 'Head-to-head knockout. Lose and you’re out.', doodle: 's-flag'}) %>
<section class="sec dark" style="margin-top:-40px;padding-top:60px"><div class="wrap stack">
<% if (!b) { %><p class="empty">No matchplay competition yet.</p><% } else { %>
  <% if (all.length > 1) { %><form method="get" action="/matchplay" class="sortrow" style="max-width:360px"><div style="flex:1"><label for="comp" style="font-weight:900;display:block">Competition</label><select class="in" id="comp" name="comp" data-autosubmit><% all.forEach(function(c){ %><option value="<%= c.id %>"<%= c.id===b.comp.id ? ' selected' : '' %>><%= c.name %></option><% }) %></select></div></form><% } %>
  <div class="panel"><p class="sub" style="margin:0">
    <% if (b.champion) { %>🏆 Champion: <b><%= b.champion %></b> (cut <%= b.comp.winner_cut %> shot<%= b.comp.winner_cut==1 ? '' : 's' %>)<% } else { %>Still being played.<% } %>
    <% if (b.holder) { %> · Holder: <a href="/players/<%= b.holder.id %>"><%= b.holder.name %></a><% } %></p></div>
  <div class="brk">
  <% b.rounds.forEach(function(r){ %>
    <section class="brk-r" aria-labelledby="r<%= r.round %>"><h3 id="r<%= r.round %>"><%= r.name %></h3>
    <% r.matches.forEach(function(m){ %>
      <div class="mt <%= m.status %>">
        <% [1,2].forEach(function(side){ var nm = m['p'+side+'_name'], id = m['p'+side+'_id'], won = m.winner===side; %>
          <div class="mp<%= won ? ' won' : '' %><%= nm==='Bye' ? ' bye' : '' %>"><span><% if (id) { %><a href="/players/<%= id %>"><%= nm %></a><% } else { %><%= nm || 'TBD' %><% } %></span><% if (won) { %><b><%= m.result || '✓' %></b><% } %></div>
        <% }) %>
      </div>
    <% }) %></section>
  <% }) %>
  </div>
  <p class="hint" style="color:#fff">Winner’s margin shown next to their name (e.g. 2&amp;1, 1 up). “✓” = went through, score not recorded.</p>
  <% if (isAdmin) { %><p><a class="btn btn-yl btn-sm" href="/admin/matchplay/<%= b.comp.id %>">Edit the bracket</a></p><% } %>
<% } %>
</div></section>
<%- include('partials/foot') %>
