<%- include('partials/head') %>
<% var half = function(v){ var w = Math.floor(v), h = v - w; return h ? (w ? w : '') + '½' : String(w); };
   var short = function(t){ return String(t).replace(/^Team /,''); };
   var res = function(m){ if (m.winner === 'H') return 'Halved'; var r = String(m.result || '').trim(); return r ? r.replace(/\bup\b/i, 'UP') : 'Won'; }; %>
<%- include('partials/pagehero', {eyebrow: 'Team golf', heading: 'Ryder Cup', lead: cups.length ? 'Every ' + S.short_name + ' Ryder Cup on record: teams, captains, sessions and points. Pick a year to see every match.' : 'No Ryder Cups on record yet.', doodle: 's-trophy'}) %>
<section class="sec yl-sec" style="margin-top:-40px;padding-top:70px"><div class="wrap stack">
<% if (years.length) { %>
  <form method="get" action="/ryder-cup" class="rc-pick" id="rc-pick">
    <label for="rc-year">Year</label>
    <select class="in" id="rc-year" name="year" data-autosubmit data-current="<%= year %>">
      <% years.forEach(function(y){ %><option value="<%= y.year %>"<%= y.year === year ? ' selected' : '' %>><%= y.year %> · <%= short(y.score_a > y.score_b ? y.team_a : y.team_b) %> <%= half(Math.max(y.score_a, y.score_b)) %>–<%= half(Math.min(y.score_a, y.score_b)) %></option><% }) %>
    </select><noscript><button class="btn btn-pk btn-sm">Go</button></noscript>
  </form>
<% } %>
<% var tcol = function(t){ return /\breds?\b/i.test(t) ? 'red' : /\bblues?\b/i.test(t) ? 'blue' : ''; }; %>
<% cups.forEach(function(c){ var winA = c.score_a > c.score_b; var ca = tcol(c.team_a), cb = tcol(c.team_b); %>
  <section class="card rcup<%= ca ? ' ta-' + ca : '' %><%= cb ? ' tb-' + cb : '' %>" aria-labelledby="rc<%= c.year %>" id="y<%= c.year %>">
    <% if (c.audio) { var lbl = c.audio_label || (c.year + ' Ryder Cup'); %>
    <div class="rc-h2"><h2 id="rc<%= c.year %>"><%= c.name %></h2>
      <button type="button" class="rc-say" id="rc-say" aria-controls="rc-audio" aria-label="Play: <%= lbl %>" title="Play: <%= lbl %>"><svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><path fill="currentColor" d="M3 9v6h4l5 4V5L7 9H3z"/><path d="M15.5 8.5a5 5 0 0 1 0 7M18 6a8.5 8.5 0 0 1 0 12" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg></button></div>
    <audio id="rc-audio" preload="auto" data-autoplay src="<%= c.audio %>"></audio>
    <% } else { %><h2 id="rc<%= c.year %>"><%= c.name %></h2><% } %>
    <div class="rc-final" role="group" aria-label="Final score">
      <div class="rc-tm a<%= winA ? ' win' : '' %>"><span><%= c.team_a %></span><b><%= half(c.score_a) %></b></div>
      <div class="rc-tm b<%= !winA ? ' win' : '' %>"><span><%= c.team_b %></span><b><%= half(c.score_b) %></b></div>
    </div>
    <p class="sr rc-score"><%= c.team_a %> <%= half(c.score_a) %> – <%= half(c.score_b) %> <%= c.team_b %></p>
    <p class="muted" style="margin-top:8px"><%= winA ? c.team_a : c.team_b %> won.<% if (c.captainA && c.captainB) { %> Captains: <%= c.captainA %> and <%= c.captainB %>.<% } %></p>

    <% c.sessions.forEach(function(s){ %>
      <div class="rc-sess">
        <div class="rc-sh"><h3><%= s.name %></h3>
          <p class="rc-tot"><span class="lbl2">Session</span> <b class="ta"><%= half(s.a) %></b>–<b class="tb"><%= half(s.b) %></b> <span class="lbl2">Running</span> <b class="ta"><%= half(s.ra) %></b>–<b class="tb"><%= half(s.rb) %></b></p>
          <p class="sr">session <%= half(s.a) %>–<%= half(s.b) %> · running <%= half(s.ra) %>–<%= half(s.rb) %></p>
        </div>
        <ol class="rc-ms">
        <% s.matches.forEach(function(m){ var w = m.winner; %>
          <li class="rc-m <%= w === 'A' ? 'wa' : w === 'B' ? 'wb' : 'wh' %>">
            <div class="rc-side a<%= w === 'A' ? ' win' : '' %>"><small><%= short(c.team_a) %></small><span><%= m.a.join(' & ') %></span><em class="pt" aria-label="<%= half(m.pa) %> point"><%= half(m.pa) %></em></div>
            <div class="rc-res"><b><%= res(m) %></b><small><%= w === 'H' ? 'shared' : short(w === 'A' ? c.team_a : c.team_b) + ' win' %></small></div>
            <div class="rc-side b<%= w === 'B' ? ' win' : '' %>"><small><%= short(c.team_b) %></small><span><%= m.b.join(' & ') %></span><em class="pt" aria-label="<%= half(m.pb) %> point"><%= half(m.pb) %></em></div>
          </li>
        <% }) %>
        </ol>
      </div>
    <% }) %>

    <div class="cols2" style="margin-top:20px">
    <% [[c.team_a, c.teamA, c.captainA, 'a'], [c.team_b, c.teamB, c.captainB, 'b']].forEach(function(t){ %>
      <div class="rc-roster <%= t[3] %>"><h3><%= t[0] %></h3>
        <table class="gt rc-pl"><thead><tr><th class="l">Player</th><th>Points</th></tr></thead><tbody>
        <% t[1].forEach(function(p){ %><tr><td class="l"><% if (p.status === 'active') { %><a href="/players/<%= p.user_id %>"><%= p.name %></a><% } else { %><%= p.name %><% } %><%= p.name === t[2] ? ' (captain)' : '' %></td><td><%= half(p.points) %></td></tr><% }) %>
        </tbody></table></div>
    <% }) %>
    </div>
    <p class="note">Pairs matches score a point for each partner. <%= c.notes || '' %></p>
  </section>
<% }) %>
</div></section>
<%- include('partials/foot') %>
