<div class="cols2"><div class="fld"><label for="tn<%= t.id || 'n' %>">Name</label><input class="in" id="tn<%= t.id || 'n' %>" name="name" required value="<%= t.name %>"></div>
<div class="fld"><label for="tk<%= t.id || 'n' %>">Type</label><select class="in" id="tk<%= t.id || 'n' %>" name="kind"><% [['major','Major'],['euro','Euro / European Open'],['other','Other']].forEach(function(k){ %><option value="<%= k[0] %>"<%= t.kind===k[0] ? ' selected' : '' %>><%= k[1] %></option><% }) %></select></div></div>
<div class="cols2"><div class="fld"><label for="ts<%= t.id || 'n' %>">Season</label><select class="in" id="ts<%= t.id || 'n' %>" name="season_id"><% h.seasonOptions(seasons).forEach(function(s){ %><option value="<%= s.id %>"<%= t.season_id===s.id ? ' selected' : '' %>><%= s.name %></option><% }) %></select></div>
<div class="fld"><label for="th<%= t.id || 'n' %>">Roll of honour trophy</label><select class="in" id="th<%= t.id || 'n' %>" name="honour_category_id"><option value="">None</option><% cats.forEach(function(c){ %><option value="<%= c.id %>"<%= t.honour_category_id===c.id ? ' selected' : '' %>><%= c.name %></option><% }) %></select></div></div>
<div class="cols2"><div class="fld"><label for="tc<%= t.id || 'n' %>">Winner cut (shots)</label><input class="in" id="tc<%= t.id || 'n' %>" name="winner_cut" inputmode="decimal" value="<%= t.winner_cut %>"></div>
<div class="fld"><label for="tt<%= t.id || 'n' %>">Cut note</label><input class="in" id="tt<%= t.id || 'n' %>" name="cut_note" maxlength="120" value="<%= t.cut_note || '' %>"></div></div>
<label class="chk"><input type="checkbox" name="cut_applies" value="1"<%= t.cut_applies ? ' checked' : '' %>> Apply the winner’s cut to their society handicap (untick for e.g. “following Euro only”)</label>
