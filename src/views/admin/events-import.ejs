<%- include('_top') %>
<% if (error) { %><p class="flash err" role="alert"><%= error %></p><% } %>
<% if (!p) { %>
<section class="card form pad-lg">
  <h2>Import events from Excel</h2>
  <p style="margin-top:8px;font-weight:700">Upload a workbook made with <b>Export to Excel</b> or the <b>blank template</b>. You’ll see a preview first; nothing is saved until you confirm.</p>
  <ul class="legend" style="margin-top:10px"><li>Rows with an ID update that event; rows without one become new events.</li><li>Events missing from the sheet are left alone (never deleted).</li><li>Unknown courses can be created, or flagged as errors.</li></ul>
  <form method="post" action="/admin/events/import" enctype="multipart/form-data" style="margin-top:16px"><%- include('../partials/csrf') %>
    <label for="file" style="font-weight:900;display:block">Excel file (.xlsx)</label>
    <input class="in" type="file" id="file" name="file" accept=".xlsx,application/vnd.openxmlformats-officedocument.spreadsheetml.sheet" required>
    <p style="margin-top:14px" class="actions"><button class="btn btn-pk" type="submit">Upload &amp; preview</button>
      <a class="btn btn-wh" href="/admin/events/export.xlsx?blank=1" download>Download blank template</a><a class="btn btn-wh" href="/admin/events">Cancel</a></p>
  </form>
</section>
<% } else { var k = p.counts; %>
<section class="card">
  <h2>Preview: <%= file %></h2>
  <p style="margin-top:8px;font-weight:700"><span class="badge ok"><%= k.new %> new</span> <span class="badge warn"><%= k.changed %> changed</span> <span class="badge"><%= k.unchanged %> unchanged</span> <span class="badge bad"><%= k.error %> with errors</span></p>
  <p class="hint" style="margin-top:6px"><%= k.error ? 'Rows with errors stop the import: fix them in the sheet and upload again.' : (k.new + k.changed ? 'Nothing has been saved yet. Check the changes, then confirm.' : 'Nothing to change: the sheet matches the app.') %></p>
</section>
<form method="post" action="/admin/events/import/confirm" class="card" id="preview" style="padding:10px 12px 16px"><%- include('../partials/csrf') %>
  <input type="hidden" name="token" value="<%= token %>">
  <% if (allUnknown && allUnknown.length) { %>
  <fieldset style="margin:4px 0 14px"><legend style="font-weight:900">Courses the app doesn’t know</legend>
    <% allUnknown.forEach(function(c){ %><label class="chk"><input type="checkbox" name="create_courses" value="<%= c %>"<%= createCourses.some(function(x){return x.toLowerCase()===c.toLowerCase()}) ? ' checked' : '' %>> Create course “<%= c %>” (par 72 placeholder; edit it in Admin → Courses)</label><% }) %>
    <p style="margin-top:8px"><button class="btn btn-wh btn-sm" type="submit" name="action" value="recheck">Update preview</button> <span class="hint">Untick to treat a course as an error instead.</span></p>
  </fieldset><% } %>
  <table class="rt"><thead><tr><th>Row</th><th>Event</th><th>Result</th><th>Details</th></tr></thead><tbody>
  <% p.rows.forEach(function(r){ %><tr class="imp-<%= r.kind %>">
    <td class="first" data-l="Row"><%= r.rowNo %></td>
    <td data-l="Event"><b><%= r.title %></b><% if (r.id) { %> <span class="muted sm">#<%= r.id %></span><% } %><% if (r.values.event_date) { %><br><span class="muted sm"><%= dateShort(r.values.event_date) %></span><% } %></td>
    <td data-l="Result"><span class="badge <%= r.kind==='new' ? 'ok' : r.kind==='changed' ? 'warn' : r.kind==='error' ? 'bad' : '' %>"><%= r.kind %></span></td>
    <td data-l="Details"><% if (r.kind==='error') { %><ul class="errs"><% r.errors.forEach(function(e){ %><li><%= e %></li><% }) %></ul>
      <% } else if (r.kind==='changed') { %><ul><% r.diffs.forEach(function(d){ %><li><b><%= d.label %>:</b> <del><%= d.from === '' || d.from == null ? '—' : d.from %></del> → <ins><%= d.to === '' || d.to == null ? '—' : d.to %></ins></li><% }) %></ul>
      <% } else if (r.kind==='new') { %>New event<%= r.values.newCourse ? ' (new course ' + r.values.newCourse + ')' : '' %><% } else { %><span class="muted">No changes</span><% } %></td></tr><% }) %>
  </tbody></table>
  <p style="margin-top:16px" class="actions">
    <% if (!k.error && (k.new + k.changed)) { %><button class="btn btn-pk" type="submit" name="action" value="apply" data-confirm="Save <%= k.new %> new and <%= k.changed %> changed event<%= k.new + k.changed === 1 ? '' : 's' %>?">Confirm &amp; save</button><% } %>
    <a class="btn btn-wh" href="/admin/events/import">Upload another file</a><a class="btn btn-wh" href="/admin/events">Cancel</a></p>
</form>
<% } %>
<%- include('_bot') %>
