<%- include('_top', {leadText: 'Prize money is entered on each event (Admin → Events → edit or enter results → Prize money). This is the season overview; nothing is worked out automatically.'}) %>
<% if (years.length > 1) { %>
<form method="get" action="/admin/prizes" class="sortrow" style="max-width:360px;margin-top:16px">
  <div style="flex:1"><label for="pz-year" style="font-weight:900;display:block">Season</label>
    <select class="in" id="pz-year" name="year" data-autosubmit><% years.forEach(function(y){ %><option value="<%= y %>"<%= y===year ? ' selected' : '' %>><%= y %></option><% }) %></select></div><noscript><button class="btn btn-yl btn-sm">Go</button></noscript>
</form>
<% } %>
<section class="card" style="margin-top:16px" aria-labelledby="pz-ae"><h2 id="pz-ae">Prize money <%= year %> <span class="badge">Admin only</span></h2>
  <% if (!events.length) { %><p style="margin-top:8px;font-weight:700">No events in <%= year %> yet. Add the events first (Admin → Events), then come back to enter the prizes.</p>
  <% } else { %>
  <div class="xs" tabindex="0" role="region" aria-label="Events in <%= year %>"><table class="rt"><thead><tr><th>Event</th><th>Date</th><th class="r">Prizes</th><th class="r">Total</th><th></th></tr></thead><tbody>
  <% events.forEach(function(e){ %><tr><td class="first" data-l="Event"><strong><%= e.title %></strong></td><td data-l="Date"><%= dateRange(e.event_date, e.end_date) %></td><td class="r" data-l="Prizes"><%= e.lines.length %></td><td class="r" data-l="Total"><%= e.lines.length ? money(e.total) : '–' %></td>
    <td data-l=""><a class="btn btn-yl btn-sm" href="/admin/events/<%= e.id %>/edit#prize-money"><%= e.lines.length ? 'Edit prizes' : 'Enter prizes' %></a></td></tr><% }) %>
  </tbody></table></div>
  <p style="margin-top:10px;font-weight:800">Season total: <%= money(events.reduce(function(s, e){ return s + e.total; }, 0)) %> · <a href="/prize-money?year=<%= year %>">See the public page</a></p>
  <% } %>
</section>
<section class="card" aria-labelledby="pz-st"><h2 id="pz-st">First prize money season</h2>
  <form class="form" method="post" action="/admin/prizes/settings" style="margin-top:10px"><%- include('../partials/csrf') %>
    <div class="fld" style="max-width:260px"><label for="pz-start">First season shown</label><input class="in" id="pz-start" name="prize_start_season" inputmode="numeric" maxlength="4" value="<%= startSet %>" placeholder="<%= start %>"><p class="hint">Earlier seasons are not shown. Blank = this year.</p></div>
    <button class="btn btn-wh btn-sm">Save</button>
  </form>
</section>
<section class="card" aria-labelledby="cpf-h" style="margin-top:22px"><h2 id="cpf-h">Competition prize fund <%= year %></h2>
  <p class="hint" style="margin-top:6px">Season kitty shared across Order of Merit, Match Play, Birdie League and FedEx Cup. Shown on those pages. Separate from the event prizes above — nothing is paid out to players from this box until you say so.</p>
  <form class="form" method="post" action="/admin/prizes/comp-fund" style="margin-top:12px"><%- include('../partials/csrf') %>
    <input type="hidden" name="year" value="<%= year %>">
    <% const f = fund || { paid_subs: null, kitty_pence: null, comps: {} }; const curSym = currency || '£';
       const amt = (p) => p == null ? '' : (p % 100 ? (p/100).toFixed(2) : String(p/100));
       const C = compPrizeMeta || []; %>
    <div class="row" style="display:flex;flex-wrap:wrap;gap:14px">
      <div class="fld" style="max-width:160px"><label for="cpf-subs">Paid subs</label><input class="in" id="cpf-subs" name="paid_subs" inputmode="numeric" value="<%= f.paid_subs == null ? '' : f.paid_subs %>" placeholder="e.g. 33"></div>
      <div class="fld" style="max-width:180px"><label for="cpf-kitty">Kitty (<%= curSym %>)</label><input class="in" id="cpf-kitty" name="kitty" inputmode="decimal" value="<%= amt(f.kitty_pence) %>" placeholder="e.g. 660"></div>
    </div>
    <% C.forEach(function(c){ const comp = (f.comps && f.comps[c.key]) || { places: [] }; const by = {}; comp.places.forEach(function(p){ by[p.place] = p.amount_pence; }); %>
      <fieldset style="margin-top:14px;border:3px solid var(--line);border-radius:12px;padding:12px 14px">
        <legend style="font:400 20px/1 var(--f-d);padding:0 6px"><%= c.label %></legend>
        <div class="row" style="display:flex;flex-wrap:wrap;gap:10px">
          <div class="fld" style="max-width:140px"><label for="cpf-<%= c.key %>-w1">Winner</label><input class="in" id="cpf-<%= c.key %>-w1" name="<%= c.key %>_w1" inputmode="decimal" value="<%= amt(by[1]) %>"></div>
          <div class="fld" style="max-width:140px"><label for="cpf-<%= c.key %>-w2">Runner-up</label><input class="in" id="cpf-<%= c.key %>-w2" name="<%= c.key %>_w2" inputmode="decimal" value="<%= amt(by[2]) %>"></div>
          <div class="fld" style="max-width:140px"><label for="cpf-<%= c.key %>-w3">Third</label><input class="in" id="cpf-<%= c.key %>-w3" name="<%= c.key %>_w3" inputmode="decimal" value="<%= amt(by[3]) %>"></div>
        </div>
      </fieldset>
    <% }) %>
    <p style="margin-top:12px"><button class="btn btn-pk btn-sm" type="submit">Save competition fund</button>
      <button class="btn btn-wh btn-sm" type="submit" name="clear" value="1">Clear <%= year %></button></p>
  </form>
</section>

<%- include('_bot') %>
