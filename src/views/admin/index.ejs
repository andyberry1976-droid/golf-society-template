<%- include('../partials/head', { title: 'Admin' }) %>
<% var C = '<input type="hidden" name="_csrf" value="' + csrf + '">'; %>
<% if (error) { %><p class="err"><%= error %></p><% } %>
<section class="card" id="events"><h2>Events</h2>
<form method="post" action="/admin/events" class="grid"><%- C %><label>Title <input name="title" required></label><label>Date <input type="date" name="event_date" required></label>
<label>Course <select name="course_id"><option value="">–</option><% courses.forEach(function (c) { %><option value="<%= c.id %>"><%= c.name %></option><% }) %></select></label>
<label>Competition <select name="competition_type_id" required><% types.forEach(function (t) { %><option value="<%= t.id %>"><%= t.name %></option><% }) %></select></label>
<label>Points multiplier <input name="multiplier" type="number" step="0.5" value="1"></label><button>Add event</button></form>
<ul><% events.forEach(function (e) { %><li><%= e.event_date %> <%= e.title %> <span class="badge"><%= e.type %></span> <a href="/admin/events/<%= e.id %>">Enter scores</a><% if (e.status === 'completed') { %> · <a href="/events/<%= e.id %>">Results</a><% } %></li><% }) %></ul></section>

<section class="card" id="types"><h2>Competition types</h2>
<ul><% types.forEach(function (t) { var c = JSON.parse(t.config); %><li><a href="/admin?type=<%= t.id %>#types"><%= t.name %></a> <span class="badge"><%= c.format %><%= c.team ? ' · ' + c.team.type : '' %></span></li><% }) %></ul>
<p>Start from: <% Object.keys(presets).forEach(function (k) { %><a class="btn" href="/admin?preset=<%= k %>#types"><%= presets[k].label %></a> <% }) %></p>
<% var c = edit.config, bon = function (w) { var b = (c.points.bonuses || []).find(function (x) { return x.when === w || (w === 'stb' && /^stableford>=/.test(x.when)); }); return b ? b.pts : ''; }; %>
<h3><%= edit.id ? 'Edit' : 'New' %>: <%= edit.name %></h3>
<form method="post" action="/admin/types" class="grid"><%- C %><input type="hidden" name="id" value="<%= edit.id || '' %>"><input type="hidden" name="preset" value="<%= c.preset %>">
<label>Name <input name="name" value="<%= edit.name %>" required></label>
<label>Format <select name="format"><% formats.forEach(function (f) { %><option <%= f === c.format ? 'selected' : '' %>><%= f %></option><% }) %></select></label>
<label>Handicap allowance % <input type="number" name="allowance_pct" min="0" max="100" value="<%= c.allowance.pct %>"></label>
<label><input type="checkbox" name="cap" value="1" <%= c.allowance.cap ? 'checked' : '' %>> Max net double bogey per hole</label>
<label><input type="checkbox" name="countback" value="1" <%= c.ranking.tieBreak === 'countback' ? 'checked' : '' %>> Ties: countback (back 9, 6, 3, 1)</label>
<label>Scoring <select name="mode"><option value="points">Points by finishing position</option><option value="score" <%= c.points.mode === 'score' ? 'selected' : '' %>>Raw stableford score</option></select></label>
<label>Points for 1st, 2nd, 3rd… <input name="positions" value="<%= c.points.positions.join(', ') %>"></label>
<label>Points for playing <input type="number" name="participation" value="<%= c.points.participation %>"></label>
<label>Bonus for playing <input type="number" name="bonus_played" value="<%= bon('played') %>"></label>
<label>Bonus per birdie <input type="number" name="bonus_birdie" value="<%= bon('birdies') %>"></label>
<label>Last place (e.g. -5) <input type="number" name="bonus_last" value="<%= bon('last') %>"></label>
<label>Bonus for scoring <input type="number" name="bonus_stb_at" value="36"> + points <input type="number" name="bonus_stb" value="<%= bon('stb') %>"></label>
<button>Save competition type</button></form></section>

<section class="card" id="leagues"><h2>Leagues</h2><ul><% leagues.forEach(function (l) { %><li><a href="/leagues/<%= l.id %>"><%= l.name %></a></li><% }) %></ul>
<form method="post" action="/admin/leagues" class="grid"><%- C %><label>Name <input name="name" required></label>
<fieldset><legend>Counts these competition types (none ticked = all)</legend><% types.forEach(function (t) { %><label><input type="checkbox" name="types" value="<%= t.id %>"> <%= t.name %></label><% }) %></fieldset>
<label>From <input type="date" name="from"></label><label>To <input type="date" name="to"></label><label>Best N scores <input type="number" name="bestN" min="1"></label><button>Add league</button></form></section>

<section class="card" id="members"><h2>Members</h2><p><%= members.map(function (m) { return m.name + ' (' + m.handicap_index + ')'; }).join(', ') %></p>
<form method="post" action="/admin/members" class="grid"><%- C %><label>Name <input name="name" required></label><label>Handicap index <input name="handicap_index" type="number" step="0.1"></label><button>Add member</button></form></section>

<section class="card" id="courses"><h2>Courses</h2><p><%= courses.map(function (c) { return c.name + (c.holes ? ' (hole-by-hole)' : ''); }).join(', ') %></p>
<form method="post" action="/admin/courses" class="grid"><%- C %><label>Name <input name="name" required></label><label>Rating <input name="rating" type="number" step="0.1" value="72"></label><label>Slope <input name="slope" type="number" value="113"></label><label>Par (if no holes) <input name="par" type="number" value="72"></label>
<label>18 hole pars <input name="pars" placeholder="4,4,3,5,…"></label><label>18 stroke indexes <input name="sis" placeholder="7,11,15,1,…"></label><button>Add course</button></form></section>

<section class="card" id="settings"><h2>Society branding</h2><form method="post" action="/admin/settings" class="grid"><%- C %>
<label>Name <input name="name" value="<%= site.name %>"></label><label>Tagline <input name="tagline" value="<%= site.tagline %>"></label>
<label>Main colour <input type="color" name="primary" value="<%= site.primary %>"></label><label>Accent colour <input type="color" name="accent" value="<%= site.accent %>"></label>
<label>Logo URL <input name="logo_url" value="<%= site.logo_url %>"></label><button>Save</button></form></section>
<%- include('../partials/foot') %>
