<%- include('partials/head') %>
<%- include('partials/pagehero', {eyebrow: 'Season ' + year, heading: 'Prize Money', lead: 'Who’s been taking the society’s money home. Placings, nearest the pins and the odd bonus prize, event by event.', doodle: 's-trophy'}) %>
<div class="page-body"><div class="wrap lift stack">
  <% if (years.length > 1) { %>
  <form method="get" action="/prize-money" class="sortrow" style="max-width:360px">
    <div style="flex:1"><label for="pz-year" style="font-weight:900;display:block">Season</label>
      <select class="in" id="pz-year" name="year" data-autosubmit><% years.forEach(function(y){ %><option value="<%= y %>"<%= y===year ? ' selected' : '' %>><%= y %></option><% }) %></select></div><noscript><button class="btn btn-yl btn-sm">Go</button></noscript>
  </form>
  <% } %>
  <section class="card pz-sum" aria-labelledby="pz-tot"><h2 id="pz-tot">Total paid out in <%= year %></h2>
    <p class="pz-big"><%= money(P.total) %></p>
    <p style="font-weight:700"><%= P.prizes %> prize<%= P.prizes === 1 ? '' : 's' %> across <%= P.events.length %> event<%= P.events.length === 1 ? '' : 's' %><% if (P.board.length) { %> · <%= P.board.length %> winner<%= P.board.length === 1 ? '' : 's' %><% } %></p>
  </section>
  <% if (!P.events.length) { %>
  <section class="card"><h2>No prize money yet</h2><p style="margin-top:8px;font-weight:700">Nothing entered for <%= year %> yet. Prizes appear here after each event.</p></section>
  <% } else { %>
  <section class="card" aria-labelledby="pz-lb"><h2 id="pz-lb">Season winnings</h2>
    <div class="xs" tabindex="0" role="region" aria-label="Prize money leaderboard <%= year %>"><table class="gt pz-lb"><thead><tr><th class="rkc">Pos</th><th class="st">Player</th><th>Prizes</th><th>Won</th></tr></thead><tbody>
    <% P.board.forEach(function(p){ %><tr><td class="rkc"><%= p.tied ? '=' : '' %><%= p.pos %></td><th class="st" scope="row"><% if (p.user_id) { %><a href="/players/<%= p.user_id %>"><%= p.name %></a><% } else { %><%= p.name %><% } %></th><td><%= p.count %></td><td class="tot"><%= money(p.total) %></td></tr><% }) %>
    </tbody><tfoot><tr><td class="rkc"></td><th class="st" scope="row">Total</th><td><%= P.prizes %></td><td class="tot"><%= money(P.total) %></td></tr></tfoot></table></div>
  </section>
  <section class="card" aria-labelledby="pz-ev"><h2 id="pz-ev">Event by event</h2>
    <div class="pz-events">
    <% P.events.forEach(function(e, i){ %>
    <details class="pz-ev" id="pz-e<%= e.id %>"<%= i === P.events.length - 1 ? ' open' : '' %>>
      <summary><span class="pz-et"><strong><a href="/events/<%= e.id %>#prize-money" class="pz-evlink"><%= e.title %></a></strong><small><%= dateRange(e.event_date, e.end_date) %></small></span><span class="pz-etot"><%= money(e.total) %></span></summary>
      <div class="xs" tabindex="0" role="region" aria-label="<%= e.title %> prizes"><table class="gt pz-lines"><thead><tr><th class="st">Prize</th><th class="l">Winner</th><th>Amount</th></tr></thead><tbody>
      <% e.lines.forEach(function(l){ %><tr class="pz-<%= l.kind %>"><th class="st" scope="row"><%= l.title %></th><td class="l"><% if (l.user_id) { %><a href="/players/<%= l.user_id %>"><%= l.name %></a><% } else { %><%= l.name %><% } %></td><td><%= money(l.amount_pence) %></td></tr><% }) %>
      </tbody><tfoot><tr><th class="st" scope="row">Event total</th><td></td><td class="tot"><%= money(e.total) %></td></tr></tfoot></table></div>
    </details>
    <% }) %>
    </div>
  </section>
  <% } %>
  <% if (isAdmin) { %><p><a class="btn btn-pk btn-sm" href="/admin/prizes?year=<%= year %>">Enter prize money</a></p><% } %>
</div></div>
<%- include('partials/foot') %>
