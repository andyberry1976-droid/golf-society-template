<%- include('partials/head') %>
<%- include('partials/pagehero', {eyebrow: 'The calendar', heading: 'Events', lead: F.on.rsvp ? 'RSVP in two taps. Full events keep a waitlist — if someone drops out, the next person is bumped in automatically.' : 'Dates, courses and tee times. Results go up after each round.', doodle: 's-flag'}) %>
<div class="page-body"><div class="wrap lift">
  <% if (isStaff) { %><p class="actions staff-bar" style="margin-bottom:18px;gap:8px"><a class="btn btn-pk btn-sm" href="/admin/events/new">+ New event</a><% if (isAdmin) { %><a class="btn btn-wh btn-sm" href="/admin/events/export.xlsx<%= selSeason ? '?season=' + selSeason.id : '' %>" download>⬇ Export to Excel</a><% } %><% if (isAdmin) { %><a class="btn btn-yl btn-sm" href="/admin/events/import">⬆ Import from Excel</a><% } %><a class="btn btn-wh btn-sm" href="/admin/events">Manage events</a></p><% } %>
  <h2 class="h2" style="font-size:clamp(30px,7vw,46px);margin:0 0 18px">Coming <u>up</u></h2>
  <% if (upcoming.length) { %><div class="cards"><% upcoming.forEach(function(e){ %><%- include('partials/evcard', {e: e, rsvps: rsvps, cur: cur}) %><% }) %></div>
  <% } else { %><p class="empty">No upcoming events yet.</p><% } %>

  <div class="row-between" style="margin:44px 0 18px">
    <h2 class="h2" style="font-size:clamp(30px,7vw,46px);margin:0">Past <u>events</u></h2>
    <form method="get" action="/events" class="sortrow" style="min-width:min(100%,260px)">
      <div><label for="season" class="sr-only">Season</label>
        <select class="in" id="season" name="season" data-autosubmit style="margin-top:0">
          <option value="all"<%= !selSeason ? ' selected' : '' %>>All seasons</option>
          <% seasons.forEach(function(s){ %><option value="<%= s.id %>"<%= selSeason && selSeason.id===s.id ? ' selected' : '' %>><%= s.name %></option><% }) %>
        </select></div>
      <noscript><button class="btn btn-yl btn-sm">Go</button></noscript>
    </form>
  </div>
  <% if (past.length) { %>
  <div class="card" style="padding:8px 10px 12px">
  <table class="rt"><thead><tr><th>Date</th><th>Event</th><th>Course</th><th>Format</th><th>Played</th><th></th></tr></thead><tbody>
    <% past.forEach(function(e){ %><tr>
      <td class="first" data-l="Date"><%= dateShort(e.event_date) %></td>
      <td data-l="Event"><a class="rowlink" href="/events/<%= e.id %>" style="font-weight:900;text-decoration:underline"><%= e.title %></a></td>
      <td data-l="Course"><%= e.course_name || '—' %></td>
      <td data-l="Format"><span class="chip <%= e.format_cls %>" style="margin:0"><%= e.format_label %></span></td>
      <td data-l="Played"><%= e.status==='completed' ? e.result_count + ' players' : '' %><% if (e.status!=='completed') { %><span class="badge warn">Results pending</span><% } %></td>
      <td class="r"><a class="btn-link" href="/events/<%= e.id %>"><%= e.status==='completed' ? 'Results →' : 'Details →' %></a></td></tr><% }) %>
  </tbody></table></div>
  <% } else { %><p class="empty">No past events for this season yet.</p><% } %>
</div></div>
<%- include('partials/foot') %>
