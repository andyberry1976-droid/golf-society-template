<%- include('partials/head') %>
<%- include('partials/pagehero', {eyebrow: todayLabel, heading: 'Birthdays', lead: people.length ? 'Many happy returns from all at ' + S.short_name + '.' : 'Cake, candles and a free pass on the first tee.', doodle: 's-spark'}) %>
<div class="page-body"><div class="wrap lift stack">
  <% if (people.length) { people.forEach(function(p){ %>
  <section class="card" aria-labelledby="bd-<%= p.id %>">
    <h2 id="bd-<%= p.id %>">🎂 Happy Birthday, <%= p.name %>! <span class="badge"><%= p.dayMonth %></span></h2>
    <p style="margin-top:6px;font-weight:700">Career highlights, straight from the society records:</p>
    <% if (p.highlights.length) { %><div class="xs" tabindex="0" role="region" aria-label="Career highlights"><table class="rt"><tbody>
      <% p.highlights.forEach(function(h){ %><tr><th scope="row"><%= h.icon %> <%= h.label %></th><td><%= h.text %></td></tr><% }) %>
    </tbody></table></div><% } else { %><p>No rounds on record yet. Here’s to the first one!</p><% } %>
    <p style="margin-top:10px"><a class="btn-link" href="/players/<%= p.id %>">Full profile →</a></p>
  </section>
  <% }) } else { %>
  <section class="card" aria-labelledby="bd-none"><h2 id="bd-none">No birthdays today</h2>
    <p style="margin-top:6px;font-weight:700">Nobody is blowing out candles today. Check back soon.</p></section>
  <% } %>
  <section class="card" aria-labelledby="bd-up"><h2 id="bd-up">Coming up</h2>
    <% if (upcoming.length) { %><table class="rt"><thead><tr><th>Player</th><th>Birthday</th><th>In</th></tr></thead><tbody>
      <% upcoming.forEach(function(u){ %><tr><td><a href="/players/<%= u.id %>"><%= u.name %></a></td><td><%= u.dayMonth %></td><td><%= u.days === 1 ? 'Tomorrow' : u.days + ' days' %></td></tr><% }) %>
    </tbody></table><% } else { %><p>No other birthdays on file yet.</p><% } %>
  </section>
</div></div>
<%- include('partials/foot') %>
