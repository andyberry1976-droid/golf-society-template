</main>
<footer>
  <div class="wrap">
    <div class="fg">
      <div><p class="fn"><%= S.society_name %></p><% var ph = /Rebrand me in Admin/i.test(S.footer_blurb || ''); %><% if (!ph && S.footer_blurb) { %><p style="margin-top:8px;font-weight:600"><%= S.footer_blurb %></p><% } else if (ph && isAdmin) { %><p style="margin-top:8px;font-weight:600"><a href="/admin/settings" style="text-decoration:underline">Admins: set your footer text in Admin → Settings</a></p><% } %><% if (S.contact_email) { %><p style="margin-top:6px;font-weight:700">Contact: <a href="mailto:<%= S.contact_email %>" style="text-decoration:underline"><%= S.contact_email %></a></p><% } %></div>
      <div><h2>Explore</h2><ul><li><a href="/">Home</a></li><% if (F.link('/events')) { %><li><a href="/events">Events</a></li><% } %><% if (F.link('/players')) { %><li><a href="/players">Players</a></li><% } %><% if (F.link('/fantasy-league')) { %><li><a href="/fantasy-league">Fantasy League</a></li><% } %><% if (F.link('/rules')) { %><li><a href="/rules">Rules</a></li><% } %><% if (adminLoginOnly) { %><% } else if (user) { %><li><a href="/account">My account</a></li><% } else { %><li><a href="/login">Log in</a></li><% if (F.link('/join')) { %><li><a href="/join">Join us</a></li><% } %><% } %><% if (F.link('/birthdays')) { %><li><a href="/birthdays">Birthdays</a></li><% } %></ul></div>
      <div><h2>Results</h2><ul><% [['/competitions','All competitions'],['/standings','Order of Merit'],['/fedex','FedEx Cup'],['/birdie-league','Birdie League'],['/matchplay','Matchplay'],['/majors','Majors &amp; Euro'],['/ryder-cup','Ryder Cup'],['/texas-scramble','Texas Scramble'],['/leagues','Leagues'],['/honours','Roll of Honour'],['/hall-of-fame','Hall of Fame'],['/records','Records'],['/handicaps','Handicap Records'],['/awards','Awards'],['/prize-money','Prize Money']].filter(function(n){ return F.link(n[0]); }).forEach(function(n){ %><li><a href="<%= n[0] %>"><%- n[1] %></a></li><% }) %></ul></div>
    </div>
    <p class="fbar">© <%= new Date().getFullYear() %> <%= S.society_name %><% if (adminLoginOnly && !user) { %> · <a href="/login" style="color:inherit;opacity:.7">Admin</a><% } %></p>
  </div>
</footer>
<script src="/js/app.js?v=5" defer></script>
</body>
</html>
