<% if (n > 0) { %><span class="mv up"><svg viewBox="0 0 14 14" aria-hidden="true"><path d="M7 2l6 9H1z" fill="currentColor"/></svg><%= n %> place<%= n>1 ? 's' : '' %><span class="sr"> up</span></span><%
 } else if (n < 0) { %><span class="mv dn"><svg viewBox="0 0 14 14" aria-hidden="true"><path d="M7 12L1 3h12z" fill="currentColor"/></svg><%= -n %> place<%= n<-1 ? 's' : '' %><span class="sr"> down</span></span><%
 } else { %><span class="mv eq"><svg viewBox="0 0 14 14" aria-hidden="true"><rect x="1" y="5.5" width="12" height="3" rx="1.5" fill="currentColor"/></svg>no change</span><% } %>
