# Copy to .env (or set these in your host's dashboard). Nothing here is required for local dev.
PORT=3000
NODE_ENV=production
# Where the SQLite file lives. On a host, point this at a persistent volume (e.g. /data/society.db)
DATABASE_PATH=./data/society.db
# REQUIRED in production: a long random string (e.g. `openssl rand -hex 32`)
SESSION_SECRET=
# First-run admin account (created automatically if the database has no users)
ADMIN_EMAIL=captain@example.com
ADMIN_NAME=Society Admin
# REQUIRED in production, min 10 chars. Must NOT be the demo password.
ADMIN_PASSWORD=
# 1 when behind a proxy that terminates TLS (Fly, Render, Railway, nginx, Caddy)
TRUST_PROXY=1
# Optional: society name used for a brand-new empty database
SOCIETY_NAME=The Fairway Flamingos Golf Society
